{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dviewer",
  "version": "0.23.0",
  "identifier": "com.xenia.dviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "dviewer",
        "width": 1180,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost https: data: blob:; connect-src 'self' ipc: http://ipc.localhost; frame-src http://127.0.0.1:*",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBRjZGQTdDMDJENjRDNjkKUldScFROWUNmUHIyT3RDUVZlUlZycEFpdWhsS0JSQ2JJalYyRm9ldThiZVBHRFF3YXVrWDJraVUK"
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      { "ext": ["pdf"], "name": "PDF document", "description": "PDF document", "role": "Viewer", "mimeType": "application/pdf" },
      { "ext": ["html", "htm"], "name": "HTML document", "description": "HTML document", "role": "Viewer", "mimeType": "text/html" },
      { "ext": ["md", "markdown", "mdown", "mkd", "mdx"], "name": "Markdown document", "description": "Markdown document", "role": "Viewer", "mimeType": "text/markdown" },
      { "ext": ["json", "geojson", "har", "jsonc", "jsonl", "ndjson"], "name": "JSON document", "description": "JSON document", "role": "Viewer", "mimeType": "application/json" },
      { "ext": ["yaml", "yml"], "name": "YAML document", "description": "YAML document", "role": "Viewer", "mimeType": "application/yaml" },
      { "ext": ["toml"], "name": "TOML document", "description": "TOML document", "role": "Viewer", "mimeType": "application/toml" },
      { "ext": ["csv"], "name": "CSV document", "description": "CSV document", "role": "Viewer", "mimeType": "text/csv" },
      { "ext": ["tsv"], "name": "TSV document", "description": "TSV document", "role": "Viewer", "mimeType": "text/tab-separated-values" },
      { "ext": ["parquet", "pq"], "name": "Parquet document", "description": "Parquet document", "role": "Viewer", "mimeType": "application/vnd.apache.parquet" },
      { "ext": ["sqlite", "sqlite3", "db3"], "name": "SQLite database", "description": "SQLite database", "role": "Viewer", "mimeType": "application/vnd.sqlite3" }
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
